{
  "name": "rpg-text-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Suite editoriale Markdown per homebrew fantasy in HTML e PDF.",
  "scripts": {
    "start": "node scripts/start-editor.js",
    "start:check": "node scripts/start-editor.js --check",
    "build": "node scripts/build.js",
    "build:html": "node scripts/build.js --html",
    "build:pdf": "node scripts/build.js --pdf",
    "build:all": "node scripts/build.js --html --pdf",
    "build:book": "node scripts/build.js --book",
    "build:book:pdf": "node scripts/build.js --book --pdf",
    "build:site": "node scripts/build.js --site",
    "export:package": "node scripts/export-package.js",
    "export:package:pdf": "node scripts/export-package.js --pdf",
    "qa:pdf": "node scripts/qa-pdf.js",
    "doctor": "node scripts/doctor.js",
    "check:legal": "node scripts/check-legal.js",
    "check:editorial": "node scripts/check-editorial.js",
    "check:assets": "node scripts/check-assets.js",
    "check:includes": "node scripts/check-includes.js",
    "check:components": "node scripts/validate-component-packs.js",
    "check:documents": "node scripts/validate-documents.js",
    "check:schema-artifacts": "node scripts/generate-schema-artifacts.js --check",
    "check:pdf-layout": "node scripts/qa-pdf.js",
    "test:rendering": "node scripts/test-render-components.js",
    "test:schema-diagnostics": "node scripts/test-schema-diagnostics.js",
    "test:editor-modules": "node --test tests/unit/editor-modules.test.js",
    "test:editor-server": "node --test tests/unit/editor-server-check.test.js",
    "test:editor-next-ui": "node scripts/test-editor-next-ui.js",
    "check": "npm run check:legal && npm run check:editorial && npm run check:assets && npm run check:includes && npm run check:components && npm run check:documents && npm run check:schema-artifacts && npm run test:rendering && npm run test:schema-diagnostics && npm run test:editor-modules && npm run test:editor-server && npm run test:editor-next-ui",
    "generate:schema-artifacts": "node scripts/generate-schema-artifacts.js",
    "new": "node scripts/new.js",
    "preview": "node scripts/serve.js",
    "preview:expanded": "node scripts/serve.js --expanded",
    "editor": "node scripts/serve-editor-next.js",
    "editor:next": "node scripts/serve-editor-next.js",
    "editor:next:build": "vite build",
    "deploy:build": "vite build --config vite.deploy.config.js",
    "deploy:preview": "vite preview --config vite.deploy.config.js --host 127.0.0.1",
    "deploy:check": "npm run check:legal && npm run check:editorial && npm run check:assets && npm run check:includes && npm run check:components && npm run check:documents && npm run check:schema-artifacts && npm run test:rendering && npm run test:schema-diagnostics && npm run test:editor-modules && npm run test:editor-server && npm run deploy:build && npm run package:editor:check",
    "package:editor": "node scripts/package-editor-app.js",
    "package:editor:check": "node scripts/package-editor-app.js --check",
    "preview:watch": "node scripts/serve.js --expanded --watch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@vitejs/plugin-react": "^6.0.1",
    "html2canvas": "^1.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.12"
  }
}
