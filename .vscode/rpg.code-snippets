{
  "TTRPG Frontmatter": {
    "prefix": "frontttrpg",
    "body": [
      "---",
      "title: ${1:Titolo}",
      "slug: ${2:slug-documento}",
      "summary: ${3:Riassunto breve.}",
      "category: ${4:avventure}",
      "tags: ${5:dungeon, livello-1}",
      "compatibility: 5e/5.5e",
      "license_mode: srd-5.2-cc",
      "author: ${6:Andrea}",
      "theme: ${7|classic-parchment,dark-arcane,clean-guild,printer-friendly|}",
      "paper: ${8|A4,Letter|}",
      "public: ${9|true,false|}",
      "---"
    ],
    "description": "Frontmatter completo per documenti TTRPG"
  },
  "Read Aloud Box": {
    "prefix": "readaloud",
    "body": [
      "<aside class=\"readaloud no-break\">",
      "  <div class=\"readaloud__label\">${1:Da leggere al tavolo}</div>",
      "  <p>${2:Testo narrativo}</p>",
      "</aside>"
    ],
    "description": "Box narrativo renderizzato in Markdown Preview"
  },
  "Encounter Box": {
    "prefix": "encounter",
    "body": [
      "<aside class=\"encounter no-break\">",
      "  <div class=\"encounter__label\">${1:Incontro}</div>",
      "  <p>${2:Dettagli tattici o conseguenze.}</p>",
      "</aside>"
    ],
    "description": "Box incontro renderizzato in Markdown Preview"
  },
  "Treasure Box": {
    "prefix": "treasure",
    "body": [
      "<aside class=\"treasure no-break\">",
      "  <div class=\"treasure__label\">${1:Tesoro}</div>",
      "  <ul>",
      "    <li>${2:Oggetto o ricompensa}</li>",
      "    <li>${3:Oggetto o ricompensa}</li>",
      "  </ul>",
      "</aside>"
    ],
    "description": "Box tesoro renderizzato in Markdown Preview"
  },
  "Note Box": {
    "prefix": "note",
    "body": [
      "<aside class=\"note no-break\">",
      "  <div class=\"note__label\">${1:Nota}</div>",
      "  <p>${2:Promemoria per master o autore.}</p>",
      "</aside>"
    ],
    "description": "Box nota renderizzato in Markdown Preview"
  },
  "Quote Box": {
    "prefix": "quote",
    "body": [
      "<aside class=\"quote no-break\">",
      "  <div class=\"quote__label\">${1:Fonte}</div>",
      "  <p>\"${2:Citazione}\"</p>",
      "</aside>"
    ],
    "description": "Citazione editoriale renderizzata in Markdown Preview"
  },
  "Monster Block": {
    "prefix": "monster",
    "body": [
      "<aside class=\"statblock monster no-break\">",
      "  <div class=\"statblock__label\">${1:Creatura}</div>",
      "  <h2>${2:Nome}</h2>",
      "  <p><em>${3:Creatura media, neutrale}</em></p>",
      "  <div class=\"statline\">",
      "    <span><strong>CA</strong> ${4:13}</span>",
      "    <span><strong>PF</strong> ${5:22}</span>",
      "    <span><strong>Vel</strong> ${6:9 m}</span>",
      "    <span><strong>GS</strong> ${7:1}</span>",
      "  </div>",
      "  <div class=\"stats-grid\">",
      "    <div><strong>FOR</strong>${8:10}<small>${9:+0}</small></div>",
      "    <div><strong>DES</strong>${10:10}<small>${11:+0}</small></div>",
      "    <div><strong>COS</strong>${12:10}<small>${13:+0}</small></div>",
      "    <div><strong>INT</strong>${14:10}<small>${15:+0}</small></div>",
      "    <div><strong>SAG</strong>${16:10}<small>${17:+0}</small></div>",
      "    <div><strong>CAR</strong>${18:10}<small>${19:+0}</small></div>",
      "  </div>",
      "  <h3 class=\"feature-heading\">Tratti</h3>",
      "  <p><strong>${20:Tratto}.</strong> ${21:Descrizione.}</p>",
      "  <h3 class=\"feature-heading\">Azioni</h3>",
      "  <p><strong>${22:Azione}.</strong> ${23:Descrizione.}</p>",
      "</aside>"
    ],
    "description": "Blocco creatura renderizzato in Markdown Preview"
  },
  "Spell Block": {
    "prefix": "spell",
    "body": [
      "<aside class=\"spell rules-card no-break\">",
      "  <div class=\"spell__label rules-card__label\">${1:Incantesimo}</div>",
      "  <h3>${2:Nome incantesimo}</h3>",
      "  <p><em>${3:1° livello}, ${4:abiurazione}</em></p>",
      "  <p class=\"rules-line\"><strong>Tempo di lancio.</strong> ${5:1 azione}</p>",
      "  <p class=\"rules-line\"><strong>Gittata.</strong> ${6:18 m}</p>",
      "  <p class=\"rules-line\"><strong>Componenti.</strong> ${7:V, S}</p>",
      "  <p class=\"rules-line\"><strong>Durata.</strong> ${8:1 minuto}</p>",
      "  <p>${9:Descrizione dell'effetto.}</p>",
      "</aside>"
    ],
    "description": "Blocco incantesimo renderizzato in Markdown Preview"
  },
  "Magic Item Block": {
    "prefix": "magicitem",
    "body": [
      "<aside class=\"magicitem rules-card no-break\">",
      "  <div class=\"magicitem__label rules-card__label\">${1:Oggetto magico}</div>",
      "  <h3>${2:Nome oggetto}</h3>",
      "  <p><em>${3:Anello}, ${4:non comune}</em></p>",
      "  <p class=\"rules-line\"><strong>Sintonia.</strong> ${5:richiesta}</p>",
      "  <p>${6:Descrizione dell'oggetto.}</p>",
      "</aside>"
    ],
    "description": "Blocco oggetto magico renderizzato in Markdown Preview"
  },
  "NPC Block": {
    "prefix": "npc",
    "body": [
      "<aside class=\"npc rules-card no-break\">",
      "  <div class=\"npc__label rules-card__label\">${1:PNG}</div>",
      "  <h3>${2:Nome}</h3>",
      "  <p><em>${3:Ruolo}</em></p>",
      "  <p class=\"rules-line\"><strong>Aspetto.</strong> ${4:Aspetto}</p>",
      "  <p class=\"rules-line\"><strong>Voce.</strong> ${5:Voce}</p>",
      "  <p class=\"rules-line\"><strong>Motivazione.</strong> ${6:Motivazione}</p>",
      "  <p class=\"rules-line\"><strong>Segreto.</strong> ${7:Segreto}</p>",
      "</aside>"
    ],
    "description": "Blocco PNG renderizzato in Markdown Preview"
  },
  "Location Block": {
    "prefix": "location",
    "body": [
      "<aside class=\"location rules-card no-break\">",
      "  <div class=\"location__label rules-card__label\">${1:Luogo}</div>",
      "  <h3>${2:Nome luogo}</h3>",
      "  <p><em>${3:buio, antico, pericoloso}</em></p>",
      "  <p class=\"rules-line\"><strong>Atmosfera.</strong> ${4:Atmosfera}</p>",
      "  <p class=\"rules-line\"><strong>Pericolo.</strong> ${5:Pericolo}</p>",
      "  <p class=\"rules-line\"><strong>Tesoro.</strong> ${6:Tesoro}</p>",
      "</aside>"
    ],
    "description": "Blocco luogo renderizzato in Markdown Preview"
  },
  "Hazard Block": {
    "prefix": "hazard",
    "body": [
      "<aside class=\"hazard rules-card no-break\">",
      "  <div class=\"hazard__label rules-card__label\">${1:Trappola}</div>",
      "  <h3>${2:Nome pericolo}</h3>",
      "  <p class=\"rules-line\"><strong>Innesco.</strong> ${3:Innesco}</p>",
      "  <p class=\"rules-line\"><strong>CD.</strong> ${4:Destrezza CD 13}</p>",
      "  <p class=\"rules-line\"><strong>Effetto.</strong> ${5:Effetto}</p>",
      "  <p class=\"rules-line\"><strong>Contromisura.</strong> ${6:Contromisura}</p>",
      "</aside>"
    ],
    "description": "Blocco pericolo o trappola renderizzato in Markdown Preview"
  },
  "Random Table": {
    "prefix": "randomtable",
    "body": [
      "<aside class=\"random-table no-break\">",
      "  <div class=\"random-table__label\">${1|d4,d6,d8,d10,d12,d20,d100|}</div>",
      "  <h3>${2:Titolo tabella}</h3>",
      "  <table class=\"table-compact\">",
      "    <thead><tr><th>${1}</th><th>Risultato</th></tr></thead>",
      "    <tbody>",
      "      <tr><td>1</td><td>${3:Risultato}</td></tr>",
      "      <tr><td>2</td><td>${4:Risultato}</td></tr>",
      "      <tr><td>3</td><td>${5:Risultato}</td></tr>",
      "      <tr><td>4</td><td>${6:Risultato}</td></tr>",
      "    </tbody>",
      "  </table>",
      "</aside>"
    ],
    "description": "Tabella casuale renderizzata in Markdown Preview"
  },
  "Columns 2": {
    "prefix": "columns2",
    "body": [
      "<div class=\"columns-2\">",
      "",
      "${1:Contenuto}",
      "",
      "</div>"
    ],
    "description": "Layout a due colonne"
  },
  "Page Break": {
    "prefix": "pagebreak",
    "body": [
      "<div class=\"page-break\"></div>"
    ],
    "description": "Interruzione pagina per PDF"
  },
  "RPG Include": {
    "prefix": "include",
    "body": [
      "<rpg-include src=\"${1:content/monsters/nome.html}\"></rpg-include>"
    ],
    "description": "Include di un componente riusabile dalla libreria content"
  }
}
